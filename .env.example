# Backend only. Copy to .env, never commit the populated file.
AI_PROVIDER=groq
GROQ_API_KEY=
# Leave blank to discover an available chat model, or choose one in Settings.
GROQ_MODEL=
# Speech-to-text is separate from the chat model. Blank discovers an available Whisper model.
GROQ_TRANSCRIPTION_MODEL=
TRANSCRIPTION_TIMEOUT_MS=120000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
AI_TIMEOUT_MS=120000
PORT=3001
CLIENT_PORT=5173
DATA_DIR=./data/minutes
